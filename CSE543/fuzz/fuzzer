#!/usr/bin/env python3
import os
import random
import signal
import subprocess
import sys


PROG = os.environ.get("FUZZ_TARGET", "/challenge/prog")
MAX_LEN = int(os.environ.get("FUZZ_MAX_LEN", "4096"))
MAX_CASES = int(os.environ.get("FUZZ_MAX_CASES", "1000000"))
TIMEOUT = float(os.environ.get("FUZZ_TIMEOUT", "1"))

SEEDS = [
    b"",
    b"A",
    b"AAAA",
    b"0",
    b"1",
    b"-1",
    b"1234",
    b"9999999999",
    b"2147483647",
    b"4294967295",
    b"%s%s%s%s",
    b"../../../../etc/passwd",
    b"\x00",
    b"\xff",
    b"A" * 64,
    b"A" * 256,
    b"A" * 1024,
]

INTERESTING = [
    b"\x00",
    b"\x01",
    b"\x7f",
    b"\x80",
    b"\xff",
    b"\n",
    b" ",
    b"A",
    b"AAAA",
    b"A" * 32,
    b"A" * 128,
    b"%x",
    b"%s",
    b"%n",
    b"-1",
    b"0",
    b"1",
    b"9999999999",
]


def mutate(data):
    data = bytearray(data)

    for _ in range(random.randint(1, 10)):
        op = random.choice(("flip", "insert", "delete", "overwrite", "append", "splice"))

        if op == "flip" and data:
            i = random.randrange(len(data))
            data[i] ^= 1 << random.randrange(8)
        elif op == "insert":
            i = random.randrange(len(data) + 1)
            data[i:i] = random.choice(INTERESTING)
        elif op == "delete" and data:
            i = random.randrange(len(data))
            del data[i]
        elif op == "overwrite" and data:
            i = random.randrange(len(data))
            data[i:i + 1] = random.choice(INTERESTING)
        elif op == "append":
            data += random.choice(INTERESTING)
        elif op == "splice":
            data += os.urandom(random.randint(1, 64))

    return bytes(data[:MAX_LEN])


def is_crash(returncode):
    fatal_signals = {
        -signal.SIGABRT,
        -signal.SIGBUS,
        -signal.SIGFPE,
        -signal.SIGILL,
        -signal.SIGSEGV,
    }
    crash_exit_codes = {134, 135, 136, 139, 140, 141, 142, 143}
    return returncode in fatal_signals or returncode in crash_exit_codes


def main():
    if len(sys.argv) > 1:
        target = sys.argv[1]
    else:
        target = PROG

    crash_num = 0
    for i in range(1, MAX_CASES + 1):
        inp = mutate(random.choice(SEEDS))

        try:
            p = subprocess.run(
                [target],
                input=inp,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=TIMEOUT,
            )
        except subprocess.TimeoutExpired:
            continue

        if is_crash(p.returncode):
            name = f"crash_{crash_num}"
            with open(name, "wb") as f:
                f.write(inp)

            print(f"[+] crash saved: {name}")
            print(f"    return code: {p.returncode}")
            print(f"    size: {len(inp)} bytes")
            return 0

        if i % 1000 == 0:
            print(f"ran {i} cases")

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
